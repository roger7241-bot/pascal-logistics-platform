    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "pdf-lib": "^1.17.1",
    "pg": "^8.23.0",
    "playwright": "^1.45.0",
    "qrcode": "^1.5.4",
    "twilio": "^6.0.2",
    "ws": "^8.17.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.17",
